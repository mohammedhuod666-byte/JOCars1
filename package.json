{
  "name": "jo-cars-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Jordanian Car Marketplace Platform - Premium Cars Trading Platform",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
      "dev": "node server.js",
      "build": "next build",
      "start": "node server.js",
      "lint": "eslint .",
      "typecheck": "tsc --noEmit",
      "audit:cache": "node scripts/audit-cache-headers.cjs",
      "test:e2e": "playwright test",
      "test:valuation": "tsx --test src/ai/valuation/__tests__/engine.test.ts src/ai/valuation/__tests__/url-verifier.test.ts src/ai/valuation/__tests__/eligibility.test.ts src/ai/valuation/__tests__/contract-scope.test.ts src/ai/valuation/__tests__/condition-flow.test.ts src/ai/valuation/__tests__/data-hygiene.test.ts src/ai/valuation/__tests__/similarity.test.ts src/ai/valuation/__tests__/description-flow.test.ts",
      "postinstall": "prisma generate",
      "db:push": "prisma db push",
      "db:migrate": "prisma migrate dev",
      "db:seed": "tsx prisma/seed.ts",
      "db:seed:cars": "tsx prisma/seed-cars.ts",
      "db:reset": "prisma migrate reset --force",
      "db:studio": "prisma studio",
      "ai:test": "tsx src/ai/test.ts",
      "build:cloudflare": "next build && opennextjs-cloudflare build && node scripts/inject-prisma-wasm-worker.cjs && node scripts/inject-cron-handler.cjs",
      "deploy:cloudflare": "wrangler deploy",
      "release:cloudflare": "npm run build:cloudflare && npm run deploy:cloudflare"
    },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "ably": "^2.29.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "clsx": "^2.1.0",
    "compression": "^1.7.4",
    "date-fns": "^3.6.0",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.18.2",
    "helmet": "^7.1.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "next-themes": "^0.3.0",
    "nodemailer": "^7.0.7",
    "openai": "^7.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.3.0",
    "use-debounce": "^10.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^6.19.3",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
