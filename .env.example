# ===== Database =====
DATABASE_URL="postgresql://user:password@localhost:5432/jo_cars?schema=public"

# ===== Authentication =====
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# ===== Cloudinary (Image Storage) =====
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Unsigned upload preset for car video (Settings > Upload > Upload presets in the
# Cloudinary dashboard). Public and non-secret by design: it grants no authority
# without a signed request, and it is REQUIRED for videos > 4MB because a Vercel
# serverless function cannot receive a body larger than 4.5MB. With it set, the
# browser uploads video straight to the CDN; without it, direct upload is
# disabled and the wizard explains the smaller inline limit.
NEXT_PUBLIC_CLOUDINARY_VIDEO_PRESET="jo_cars_video_unsigned"

# ===== Google Login (OAuth 2.0) =====
# Create credentials at https://console.cloud.google.com/apis/credentials
# Type: OAuth client ID / Web application. Add Authorized JavaScript origins:
# http://localhost:3000 + your production + ngrok URLs.
# Both vars use the SAME client ID (one public for the button, one server-side for verification).
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_ID="your-google-client-id"

# ===== Google Maps =====
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# ===== AI Engine =====
# NVIDIA NIM API for AI-powered features (chat, description, price estimation)
NVIDIA_API_KEY="your-nvidia-api-key-here"

# Optional: set DISABLE_AI="true" to turn off AI features (the heuristic
# modules will still return data, but with a reduced confidence flag).
# DISABLE_AI="false"

# ===== WhatsApp (UltraMsg - OTP + notifications) =====
# Get from https://ultramsg.com - without these, OTP codes are logged
# server-side only and login-otp returns 503. Required for production.
ULTRA_MSG_TOKEN=""
ULTRA_MSG_INSTANCE="instance0"

# ===== Email (SMTP) =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@jocars.com"

# ===== Backups (every 5h auto + manual from /admin/backups) =====
# Secret that authorizes the internal scheduler (server.js) to trigger backups.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_CRON_SECRET="change-me-to-a-random-secret"
# Where backup files are emailed (WhatsApp notify goes to site admins automatically)
BACKUP_EMAIL_TO="mohammedhuod666@gmail.com"
# AES-256 key (64 hex chars) that encrypts the EMAILED backup copy.
# Without it, backups are emailed in plaintext. Generate with the command above.
# BACKUP_ENCRYPTION_KEY="change-me-to-64-hex-chars"
# Auto-prune AUTO snapshots older than N days (keeps 3 newest always). Manual kept.
BACKUP_RETENTION_DAYS=14
# Shared secret between the edge middleware (proxy.ts) and the internal
# sentinel ingestion endpoint. Random 64-hex string, never exposed.
# SENTINEL_INTERNAL_SECRET="change-me-to-a-random-secret"

# ===== Rate limiting / OTP (multi-instance) =====
# Without these, rate limits + OTP codes live in server memory (single instance only).
# Set both to share state across instances via Upstash Redis.
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ===== App Configuration =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JO Cars"
NEXT_PUBLIC_APP_DESCRIPTION="أفضل منصة أردنية لبيع وشراء السيارات"
NEXT_PUBLIC_CONTACT_EMAIL="info@jocars.com"
NEXT_PUBLIC_CONTACT_PHONE="+962 6 500 0000"

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===== Storage =====
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760

# ===== 3D Model & AR =====
NEXT_PUBLIC_MODEL_VIEWER_API_KEY="your-model-viewer-key"

# ===== Feature Flags =====
ENABLE_3D_MODELS=true
ENABLE_AR_VIEWER=true
ENABLE_SMART_SEARCH=true
ENABLE_DAMAGE_DETECTION=true

# ===== Security =====
CSRF_SECRET="your-csrf-secret-change-in-production"
GEO_RESTRICT_JORDAN=false
ADMIN_EMAIL="admin@jocars.com"
ADMIN_PASSWORD="generate-a-strong-password"
